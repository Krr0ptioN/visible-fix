API_PORT=8031
WEB_PORT=3001
APP_NAME=visiblefix-api
NODE_ENV=development

# Local Postgres for VisibleFix
DATABASE_URL=postgres://postgres:postgres@localhost:5432/visiblefix

# API auth secrets (required)
JWT_ACCESS_SECRET=replace-with-a-local-access-secret
JWT_REFRESH_SECRET=replace-with-a-local-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional local admin seed. Configure both email and password to seed an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=VisibleFix Admin

# Client-facing API base (used by Next rewrite origin detection)
NEXT_PUBLIC_API_URL=http://localhost:8031/api/v1

# Google Maps API Key for maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Object storage (photo evidence)
# Supported providers: local | minio | gcs
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=visiblefix-dev
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:8031/uploads
OBJECT_STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Local storage provider config
LOCAL_OBJECT_STORAGE_ROOT=storage

# MinIO / S3-compatible provider config
# Required when OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Google Cloud Storage provider config
# Required when OBJECT_STORAGE_PROVIDER=gcs
GCS_PROJECT_ID=
GCS_KEY_FILENAME=
GCS_MAKE_PUBLIC=true

# Logging (pino / nestjs-pino)
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_TO_LOKI=false
LOKI_HOST=http://localhost:3100

# OpenTelemetry tracing
OTEL_SERVICE_NAME=visiblefix-api
OTEL_SDK_DISABLED=false
OTEL_LOG_LEVEL=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Google Cloud project (optional, for managed observability)
GOOGLE_CLOUD_PROJECT=

# Sentry (Next.js)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
