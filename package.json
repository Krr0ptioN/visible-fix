    "@trpc/client": "^11.16.0",
    "@trpc/next": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@types/passport-jwt": "^4.0.1",
    "@vercel/analytics": "^2.0.1",
