{
  "name": "@visiblefix/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "setup:dev": "bash scripts/setup-dev-env.sh",
    "dev:web": "nx serve web",
    "dev:api": "nx serve visiblefix-api",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "build:web": "nx build web",
    "build:web:vercel": "next build apps/web",
    "serve:web:vercel": "next start apps/web -p 3000",
    "build:api": "nx build visiblefix-api",
    "lint": "nx lint",
    "test": "nx test",
    "infra:up": "bash infra/compose-runner.sh up -d",
    "infra:down": "bash infra/compose-runner.sh down",
    "infra:logs": "bash infra/compose-runner.sh logs -f",
    "infra:ps": "bash infra/compose-runner.sh ps",
    "obs:up": "docker compose -f infra/observability/docker-compose.yml up -d",
    "obs:down": "docker compose -f infra/observability/docker-compose.yml down",
    "obs:logs": "docker compose -f infra/observability/docker-compose.yml logs -f",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:apply-schema": "node scripts/apply-schema.mjs",
    "db:migrate:check": "DRY_RUN=true MIGRATION_MODE=expand node scripts/ci/migrate-compatible.mjs",
    "db:migrate:expand": "MIGRATION_MODE=expand node scripts/ci/migrate-compatible.mjs",
    "db:migrate:contract": "ALLOW_CONTRACT_MIGRATIONS=true MIGRATION_MODE=contract node scripts/ci/migrate-compatible.mjs",
    "db:seed:dev": "node scripts/seed-dev.mjs"
  },
  "devDependencies": {
    "@nx/eslint": "22.6.4",
    "@nx/nest": "^22.6.4",
    "@nx/next": "^22.6.4",
    "@nx/react": "^22.6.4",
    "@nx/webpack": "22.6.4",
    "@playwright/test": "^1.59.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "autoprefixer": "10.4.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "next": "^16.2.2",
    "nx": "22.6.4",
    "postcss": "8.4.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "3.4.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@google-cloud/storage": "^7.19.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
